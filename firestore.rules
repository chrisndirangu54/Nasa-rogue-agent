rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function owner(){return signedIn() && resource.data.ownerUid == request.auth.uid;}
  function staff(){return signedIn() && request.auth.token.staff == true;}
  function validCase(){
   let d=request.resource.data;
   return d.keys().hasOnly(['ownerUid','category','area','agent','description','amount','outcome','status','createdAt','updatedAt'])
     && d.keys().hasAll(['ownerUid','category','area','agent','description','amount','outcome','status','createdAt','updatedAt'])
     && d.ownerUid==request.auth.uid
     && d.category in ['deposit','harassment','fees','eviction','other']
     && d.outcome in ['refund','mediation','stop','advice','other']
     && d.area is string && d.area.size()>0 && d.area.size()<=120
     && d.agent is string && d.agent.size()<=150
     && d.description is string && d.description.size()>=30 && d.description.size()<=5000
     && d.amount is number && d.amount>=0 && d.amount<=100000000
     && d.status=='submitted' && d.createdAt==request.time && d.updatedAt==request.time;
  }
  match /cases/{caseId}{
   allow create: if signedIn() && validCase();
   allow get,list: if owner() || staff();
   allow update,delete: if false;
  }
  // All other collections are exclusively managed through audited Cloud Functions.
  match /{document=**}{allow read,write: if false;}
 }
}